# =============================================================================
# Solo - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For production, use .env.production as a template:
#   cp .env.production .env
#   ./scripts/gen-secret.sh >> .env
# =============================================================================

# ---- Database ----
# PostgreSQL connection string for local development
DATABASE_URL=postgres://solo:solo-dev@localhost:5432/solo?sslmode=disable

# ---- Authentication ----
# JWT signing secret (use a strong random value in production)
JWT_SECRET=change-me-in-production

# Public deployment URL and account policy
PUBLIC_URL=http://localhost:3000
ALLOW_SIGNUP=true
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# SMTP is required when APP_ENV=production. Development logs codes instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
# Optional fixed six-digit code outside production, useful for local E2E.
SOLO_DEV_AUTH_CODE=

# Internal token secret for server-daemon communication
INTERNAL_TOKEN_SECRET=change-me-in-production

# ---- AI Provider ----
# API key for the LLM provider (Anthropic or OpenAI)
LLM_API_KEY=

# LLM provider: "anthropic", "openai", or "local"
# "local" uses a locally installed CLI agent (e.g., Claude Code `claude` command).
# When set to "local", LLM_API_KEY is not required.
LLM_PROVIDER=local

# Binary path for the "local" provider (default: "claude")
# Example: CLAUDECODE_BIN=claude
CLAUDECODE_BIN=

# ---- Server ----
# API server listen port
SERVER_PORT=8080

# ---- Frontend ----
# Next.js development server listen port
FRONTEND_PORT=3000

# ---- Daemon ----
# Daemon HTTP server listen port
DAEMON_PORT=8081

# Unique identifier for this daemon instance
DAEMON_ID=daemon-01

# Server URL for a standalone daemon. The make-managed local stack derives
# this URL from SERVER_PORT.
DAEMON_SERVER_URL=http://127.0.0.1:8080

# Release idle provider processes while keeping their sessions resumable.
AGENT_SESSION_IDLE_TTL=30m
THINKING_SESSION_IDLE_TTL=30m
SESSION_IDLE_SWEEP_INTERVAL=1m

# ---- Logging ----
# Log level: debug, info, warn, error
LOG_LEVEL=debug
