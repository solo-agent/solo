SOLO_DOMAIN=solo.example.com
POSTGRES_DB=solo
POSTGRES_USER=solo
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://solo:replace-with-a-url-escaped-password@postgres:5432/solo?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info

# Auth email delivery. Tencent personal accounts opened after 2026-03-02 use
# the SES API because SMTP is unavailable. The template must contain
# {{intro}} and {{code}} and be approved before deployment.
AUTH_MAIL_TRANSPORT=tencent_ses
TENCENTCLOUD_SECRET_ID=replace-with-a-dedicated-cam-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-a-dedicated-cam-secret-key
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM=Solo <noreply@solo.example.com>
TENCENT_SES_TEMPLATE_ID=replace-with-an-approved-template-id

# SMTP remains supported for other providers (set AUTH_MAIL_TRANSPORT=smtp).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls for port 587; implicit for SMTPS/port 465
SMTP_TLS=starttls

# New-account policy. Existing users can always log in.
ALLOW_SIGNUP=true
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# Override only when distributing the installer from another trusted origin.
NEXT_PUBLIC_INSTALL_URL=https://raw.githubusercontent.com/solo-agent/solo/master/scripts/install.sh
